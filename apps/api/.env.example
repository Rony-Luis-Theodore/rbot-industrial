# R-Bot Industrial — entorno local (demo)

APP_NAME=R-Bot Industrial
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Demo sin robot (default GitHub v1) ---
LLM_PROVIDER=mock
ROS_PROVIDER=mock

# --- Opcional: Ollama local (sigue sin robot si ROS_PROVIDER=mock) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# Tras Colab + ollama create: OLLAMA_MODEL=rbot-operator

# --- Opcional: robot / lab real (Linux + ROS 2) ---
# ROS_PROVIDER=rclpy
# ROBOT_PROFILE=auto
# ROS_DOMAIN_ID=0
# ROS_RMW=rmw_fastrtps_cpp
# ROS_WS_SETUP=~/Documents/Proyectos/_local/ros/upnrobot-ros-main/install/setup.bash
# ROS_MAP_DIR=~/Documents/Proyectos/_local/ros/upnrobot-ros-main/src/kalman_bringup/map

# Voz fallback (faster-whisper): base | small | ruta a modelo fine-tuned
ML_WHISPER_MODEL=base

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
